# Copy this file to .env.local for development and replace every placeholder.
# Never commit real secret values.
NODE_ENV=development
PORT=3000

# The publishable key is intentionally present in both environments: Vite
# embeds VITE_* values into the browser bundle; Express/Clerk reads the
# non-VITE version on the server.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_the_same_key
CLERK_SECRET_KEY=replace_with_your_clerk_secret_key

# Server-only. Never prefix this with VITE_.
GEMINI_API_KEY=replace_with_your_gemini_key

# PostgreSQL. Gandi uses localhost:5432; use a dedicated application role.
DATABASE_URL=postgresql://pawprints_app:replace_with_database_password@localhost:5432/pawprints

# Development may leave this empty. Production must use a comma-separated
# HTTPS allowlist; see docs/DEPLOYMENT.md for the exact Pawprint value.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Multi-domain Clerk configuration. Production values are documented in
# docs/DEPLOYMENT.md.
VITE_CLERK_PRIMARY_DOMAIN=localhost
VITE_CLERK_SATELLITE_DOMAINS=
VITE_CLERK_SIGN_IN_URL=http://localhost:3000/app
VITE_CLERK_SIGN_UP_URL=http://localhost:3000/app
